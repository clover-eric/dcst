DCST_PORT=10123
TZ=Asia/Shanghai
# 国内镜像或自建 registry 可覆盖此地址
DCST_IMAGE=ghcr.io/clover-eric/dcst:latest
# 从源码构建时可替换基础镜像
GO_IMAGE=golang:1.27-alpine
ALPINE_IMAGE=alpine:3.22
# 仅供 docker-compose.fnos.yml 使用
DCST_DATA_DIR=/vol1/1000/docker/dcst/data
INTERVAL_MINUTES=60
CANDIDATES=40
STREAMS=16
TEST_DURATION_SECONDS=5
WARMUP_SECONDS=1
TEST_URL=https://cf.xiu2.xyz/url
# 可选：旧版管理 API 兼容令牌。Web 管理使用首次访问时设置的 8 位数字密码。
ADMIN_TOKEN=
# 一键升级代理；仅在 Docker 内部网络暴露，建议保持随机且足够长
UPDATE_API_TOKEN=dcst-local-updater-change-me
WATCHTOWER_IMAGE=nickfedor/watchtower:1.23.2
